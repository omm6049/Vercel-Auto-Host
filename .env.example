# ==========================================
# Vercel Auto Host - Environment Configuration
# ==========================================

# Port for the Web Dashboard server
PORT=3000

# Telegram Bot Token (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Vercel Access Token (Get from https://vercel.com/account/tokens)
VERCEL_TOKEN=your_vercel_access_token_here

# Optional: Vercel Team ID / Scope (Leave blank for personal account)
VERCEL_TEAM_ID=

# Optional: Vercel Blob Read-Write Token (Get from Vercel Storage -> Blob)
BLOB_READ_WRITE_TOKEN=

# Optional: Vercel Edge Config ID (Auto-created or manual from Vercel Storage -> Edge Config)
EDGE_CONFIG_ID=
